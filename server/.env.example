# Salin ke .env lokal di direktori server. Jangan commit nilai rahasia.
PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/examedu.sqlite
# Isi dengan rahasia acak panjang hanya bila pendaftaran guru diaktifkan.
TEACHER_SIGNUP_CODE=ganti-dengan-kode-rahasia-minimal-32-karakter
# Daftar origin aplikasi, dipisahkan koma. Ganti untuk domain produksi.
APP_ORIGINS=http://localhost:5173,http://localhost:5174
# Jika API dan aplikasi memakai site berbeda, perlu HTTPS dan COOKIE_SAMESITE=none.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
