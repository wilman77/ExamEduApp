# Pilih salah satu: DATABASE_URL atau lima field PG* di bawah.
# Jangan commit nilai asli atau kredensial database.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# PGHOST=aws-1-ap-southeast-1.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.<project-ref>
# PGPASSWORD=ganti-dengan-password-database
DATABASE_SSL=true
PG_POOL_SIZE=5
PORT=8787
NODE_ENV=development

# Isi dengan origin persis aplikasi guru dan siswa; pisahkan dengan koma.
APP_ORIGINS=http://localhost:5173,http://localhost:5174

# Rahasia panjang untuk pendaftaran guru; simpan hanya sebagai secret di host.
TEACHER_SIGNUP_CODE=ganti-dengan-kode-rahasia-minimal-32-karakter

# Produksi HTTPS: set COOKIE_SECURE=true. Gunakan "none" hanya bila perlu
# cookie lintas-site; browser dapat membatasi cookie pihak ketiga.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
